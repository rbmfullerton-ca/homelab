{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "minimumReleaseAgeBehaviour": "relax-requirement-on-missing-data",
  "customManagers": [
    {
      "description": "Matches standard image/image_version pairs",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)variables\\.tf$/"
      ],
      "matchStrings": [
        "variable\\s+\"image\"\\s+{[^}]*?default\\s+=\\s+\"(?<depName>[^\"]+)\"[^}]*?}\\s+variable\\s+\"image_version\"\\s+{[^}]*?default\\s+=\\s+\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Matches image2/image_version2",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)variables\\.tf$/"
      ],
      "matchStrings": [
        "variable\\s+\"image2\"\\s+{[^}]*?default\\s+=\\s+\"(?<depName>[^\"]+)\"[^}]*?}\\s+variable\\s+\"image_version2\"\\s+{[^}]*?default\\s+=\\s+\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Matches Helm repo, chart, and ver variables",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)variables\\.tf$/"
      ],
      "matchStringsStrategy": "combination",
      "matchStrings": [
        "variable\\s+\"repo\"\\s+{[^}]*?default\\s+=\\s+\"(?<registryUrl>[^\"]+)\"",
        "variable\\s+\"chart\"\\s+{[^}]*?default\\s+=\\s+\"(?<depName>[^\"]+)\"",
        "variable\\s+\"ver\"\\s+{[^}]*?default\\s+=\\s+\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "helm"
    },
    {
      "description": "Matches inline container images in .tf files",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.tf$/"
      ],
      "matchStrings": [
        "image\\s+=\\s+\"(?<depName>[^:]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Matches image and version labels in Kubernetes YAML",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.yaml$/"
      ],
      "matchStrings": [
        "image:\\s+(?<depName>[^:]+):(?<currentValue>[^\\s\\n\"]+)",
        "app\\.kubernetes\\.io/version:\\s+(?<currentValue>[^\\s\\n\"]+)"
      ],
      "depNameTemplate": "ghcr.io/kube-vip/kube-vip",
      "datasourceTemplate": "docker"
    },
    {
      "description": "Matches NVIDIA plugin in HCL maps",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.tf$/"
      ],
      "matchStrings": [
        "\"image\"\\s+=\\s+\"(?<depName>nvcr\\.io/nvidia/k8s-device-plugin):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Universal Docker logic - semver by default",
      "matchDatasources": ["docker"],
      "versioning": "semver"
    },
    {
    "description": "Docker versioning for non-semver images",
    "matchDatasources": ["docker"],
    "matchPackageNames": [
      "pihole/pihole",
      "visibilityspots/cloudflared",
      "redis",
      "mariadb"
    ],
    "versioning": "docker"
    },
    {
      "description": "Radarr: Handle 'version-' with 4-part versioning (e.g., 6.0.4.10291)",
      "matchPackageNames": ["lscr.io/linuxserver/radarr"],
      "versioning": "regex:^(?<compatibility>version-)(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
    },
    {
      "description": "Jackett: Handle 3-part or 4-part versioning with optional linuxserver build suffixes",
      "matchPackageNames": ["lscr.io/linuxserver/jackett"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?(?:-ls(?<revision>\\d+))?$"
    },
    {
      "description": "Bookshelf: Handle 'hardcover-v' with 4-part versioning (e.g., 0.4.20.127)",
      "matchPackageNames": ["ghcr.io/pennydreadful/bookshelf"],
      "versioning": "regex:^(?<compatibility>.*-v)(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
    },
    {
      "description": "CUDA date-based versioning for ComfyUI",
      "matchPackageNames": ["mmartial/comfyui-nvidia-docker"],
      "versioning": "regex:^(?<compatibility>ubuntu24_cuda12\\.6\\.3-)(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})$"
    }
  ]
}
